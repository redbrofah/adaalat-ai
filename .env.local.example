# =====================================================================
# AdaalatAI — Environment Variables Template
# Copy this file to .env.local and fill in your actual keys
# =====================================================================

# --- Anthropic API (REQUIRED) ---
# Get your key from: https://console.anthropic.com
# Make sure your $500 hackathon credit is applied to this key.
ANTHROPIC_API_KEY=sk-ant-PASTE-YOUR-KEY-HERE

# --- Voyage AI Embeddings (REQUIRED for vector search) ---
# Get your key from: https://www.voyageai.com (free $50 credit)
# Used by bdlaws-mcp and scob-mcp for semantic search
VOYAGE_API_KEY=pa-PASTE-YOUR-VOYAGE-KEY-HERE

# --- Model Configuration ---
# Use Opus 4.7 for high-stakes reasoning, Sonnet 4.6 for cheaper tasks
MODEL_OPUS=claude-opus-4-7
MODEL_SONNET=claude-sonnet-4-6
MODEL_HAIKU=claude-haiku-4-5-20251001

# --- Data Paths (relative to project root) ---
DATA_DIR=./data
BDLAWS_DIR=./data/bdlaws/acts
SCOB_DIR=./data/scob-pdfs
LANCEDB_DIR=./data/index/lancedb
UPLOADS_DIR=./data/uploads

# --- Feature Flags ---
ENABLE_VISION_AGENT=true
ENABLE_CRITIC_LOOP=true
MAX_PARALLEL_AGENTS=5

# --- Budget Tracking ---
MAX_BUDGET_PER_CASE_USD=2.50
LOG_TOKEN_USAGE=true
