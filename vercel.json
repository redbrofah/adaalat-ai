{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "src/app/api/case/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/case/[id]/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/case/[id]/events/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/case/[id]/reprocess/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/samples/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/samples/[slug]/route.ts": {
      "maxDuration": 10
    }
  }
}
